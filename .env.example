# KGCS Environment Variables — Example Configuration
#
# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored; this file is committed and kept in sync with the code.
#
# All variables are optional unless marked REQUIRED.

# ---------------------------------------------------------------------------
# Neo4j connection (REQUIRED for API to be ready)
# ---------------------------------------------------------------------------

# Connection URI for the Neo4j instance.
# Use bolt:// for local/unencrypted, neo4j+s:// for TLS-encrypted.
NEO4J_URI=bolt://localhost:7687

# Neo4j credentials.
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Optional: target a named database (default: the Neo4j default database).
# NEO4J_DATABASE=kgcs-v2

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# Listening port for the aiohttp API server.
PORT=8080

# ---------------------------------------------------------------------------
# Security (P5.2)
# ---------------------------------------------------------------------------

# API key required in the X-API-Key or Authorization: Bearer header.
# Leave unset to disable authentication (development only).
# KGCS_API_KEY=my-secret-key

# Requests-per-minute cap per client IP on /query and /ask.
# Set to 0 to disable rate limiting.
# Default: 60
# KGCS_RATE_LIMIT=60

# Maximum allowed request body size in bytes.
# Default: 1048576 (1 MiB)
# KGCS_MAX_REQUEST_SIZE=1048576

# ---------------------------------------------------------------------------
# Failure handling / timeouts (P5.3)
# ---------------------------------------------------------------------------

# Wall-clock deadline for the entire orchestration pipeline (seconds).
# Requests exceeding this limit return HTTP 504.
# Default: 30
# KGCS_ORCHESTRATOR_TIMEOUT=30

# Neo4j query timeout in seconds.  Overrides the Neo4jClient constructor default.
# Default: 30
# NEO4J_QUERY_TIMEOUT=30

# ---------------------------------------------------------------------------
# Observability (P5.1)
# ---------------------------------------------------------------------------

# Log format: "json" (structured, production default) or "text" (plain, local dev).
# Default: json
# KGCS_LOG_FORMAT=text

# Queries taking longer than this threshold (milliseconds) emit a WARNING.
# Default: 5000
# NEO4J_SLOW_QUERY_MS=5000

# ---------------------------------------------------------------------------
# Smoke test helper (scripts/smoke_test.py)
# ---------------------------------------------------------------------------

# Base URL of the running KGCS API.  Used by smoke_test.py when no --base-url is given.
# KGCS_API_URL=http://localhost:8080
